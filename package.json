{
  "name": "contarodizio",
  "version": "1.0.0",
  "description": "Contador de fatias de rodízio em tempo real com estatísticas e modo escuro nativo",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "start": "npm run dev",
    "server": "node server/index.js",
    "client": "npm --prefix BatalhaDeRodizio run dev",
    "build": "npm --prefix BatalhaDeRodizio run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
